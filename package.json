{
  "name": "reccut",
  "productName": "Reccut",
  "version": "0.2.0",
  "description": "Record, edit and export tutorial videos",
  "main": "src/main/main.js",
  "author": "sirbull",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "node scripts/build.mjs && electron .",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --win --publish never",
    "test": "node --test test/*.test.mjs",
    "test:render": "electron scripts/verify-effects.cjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@preact/signals": "^2.11.4",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "lucide-preact": "^1.65.0",
    "mediabunny": "^1.65.0",
    "preact": "^10.29.8"
  },
  "build": {
    "appId": "no.sirbull.reccut",
    "productName": "Reccut",
    "electronLanguages": [
      "en",
      "en-US",
      "en-GB"
    ],
    "files": [
      "build/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en"
        ],
        "NSCameraUsageDescription": "Reccut uses your camera to include you in recordings.",
        "NSMicrophoneUsageDescription": "Reccut uses your microphone to record audio.",
        "NSScreenCaptureUsageDescription": "Reccut records your screen.",
        "NSAppleEventsUsageDescription": "Reccut displays keystrokes in recordings."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033"
    },
    "linux": {
      "target": "AppImage"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "fileAssociations": [
      {
        "ext": "reccut",
        "name": "Reccut Project",
        "description": "Reccut Project",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "immer": "^10.1.1",
    "uiohook-napi": "^1.5.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sirbull/OBSlite"
  }
}
