{
  "name": "reccut",
  "productName": "Reccut",
  "version": "0.2.0",
  "description": "Ta opp, rediger og eksporter opplæringsvideoer",
  "main": "src/main/main.js",
  "author": "sirbull",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "node scripts/build.mjs && electron .",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --win --publish never",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "@preact/signals": "^2.11.4",
    "lucide-preact": "^1.65.0",
    "mediabunny": "^1.65.0"
  },
  "build": {
    "appId": "no.sirbull.reccut",
    "productName": "Reccut",
    "files": [
      "build/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Reccut bruker kameraet for å vise deg i opptaket.",
        "NSMicrophoneUsageDescription": "Reccut bruker mikrofonen for å ta opp lyd.",
        "NSScreenCaptureUsageDescription": "Reccut tar opp skjermen din.",
        "NSAppleEventsUsageDescription": "Reccut viser tastetrykk i opptaket."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": "AppImage"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "fileAssociations": [
      {
        "ext": "reccut",
        "name": "Reccut Project",
        "description": "Reccut Project",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "uiohook-napi": "^1.5.5"
  }
}
