{
  "name": "reccut",
  "productName": "Reccut",
  "version": "0.9.3",
  "description": "Record, edit and export tutorial videos",
  "main": "src/main/main.js",
  "author": "sirbull",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "postinstall": "node scripts/fetch-ffmpeg.mjs",
    "start": "node scripts/start.mjs",
    "dist": "node scripts/fetch-ffmpeg.mjs && node scripts/build-braw.mjs && node scripts/build.mjs && electron-builder --publish never",
    "dist:mac": "node scripts/fetch-ffmpeg.mjs && node scripts/build-braw.mjs && node scripts/build.mjs && electron-builder --mac --publish never",
    "dist:win": "node scripts/fetch-ffmpeg.mjs win-x64 && node scripts/build-braw.mjs && node scripts/build.mjs && electron-builder --win --publish never",
    "dist:linux": "node scripts/fetch-ffmpeg.mjs linux-x64 && node scripts/build-braw.mjs && node scripts/build.mjs && electron-builder --linux --x64 --publish never",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@preact/signals": "^2.11.4",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-preact": "^1.65.0",
    "mediabunny": "^1.65.0",
    "preact": "^10.29.8"
  },
  "build": {
    "appId": "no.sirbull.reccut",
    "productName": "Reccut",
    "electronLanguages": [
      "en",
      "en-US",
      "en-GB"
    ],
    "files": [
      "build/**/*",
      "!build/licenses/**/*",
      "src/main/**/*",
      "assets/icon.png",
      "assets/reccut-wordmark.svg",
      "src/shared/pluginTerms.json",
      "src/shared/recordingFormats.cjs",
      "src/shared/stockSources.cjs",
      "src/shared/tts.js",
      "package.json"
    ],
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.video",
      "identity": "-",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en"
        ],
        "NSCameraUsageDescription": "Reccut uses your camera to include you in recordings.",
        "NSCameraUseContinuityCameraDeviceType": true,
        "NSMicrophoneUsageDescription": "Reccut uses your microphone to record audio.",
        "NSScreenCaptureUsageDescription": "Reccut records your screen."
      }
    },
    "dmg": {
      "background": "assets/dmg-background.png",
      "iconSize": 96,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 180,
          "y": 200,
          "type": "file"
        },
        {
          "x": 480,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "build/licenses",
        "to": "licenses"
      },
      {
        "from": "vendor/ffmpeg/${os}-${arch}",
        "to": "ffmpeg"
      },
      {
        "from": "vendor/decoders",
        "to": "decoders"
      }
    ],
    "npmRebuild": false,
    "fileAssociations": [
      {
        "ext": "reccut",
        "name": "Reccut Project",
        "description": "Reccut Project",
        "role": "Editor"
      },
      {
        "ext": "reccut-plugin",
        "name": "Reccut Plugin",
        "description": "Reccut Plugin",
        "role": "Viewer"
      }
    ],
    "beforePack": "scripts/before-pack.cjs"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "pdfjs-dist": "^6.4.299"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sirbull/reccut"
  }
}
